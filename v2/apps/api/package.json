    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.0",
    "nodemailer": "^9.1.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "zod": "^4.1.5"
