APP_NAME=design-hub-v2-staging
NODE_ENV=production

# Use o endereço de teste. O frontend e a API devem ficar no mesmo domínio,
# com as chamadas /api encaminhadas para o processo Node.
APP_URL=https://novo.seudominio.com
API_URL=https://novo.seudominio.com
API_PORT=3000
DEMO_MODE=false

# Banco MySQL vazio criado para o ambiente de teste.
DB_HOST=mysql.example-host.com
DB_PORT=3306
DB_NAME=design_hub_v2_staging
DB_USER=design_hub_v2_user
DB_PASSWORD=replace-with-a-strong-password

# Gere um segredo longo e exclusivo. Nunca reutilize o valor deste exemplo.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
APP_TIMEZONE=America/Sao_Paulo

# Precisa apontar para uma pasta persistente e protegida por backup.
UPLOAD_DIR=/absolute/persistent/path/design-hub-v2/uploads

OPENAI_API_KEY=
