APP_NAME=design-hub-v2
NODE_ENV=development

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DEMO_MODE=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=design_hub_v2
DB_USER=root
DB_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
APP_TIMEZONE=America/Sao_Paulo
OPENAI_API_KEY=

# Recuperação de senha por uma caixa de e-mail criada na Hostinger.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=senha-da-caixa-de-email
SMTP_FROM_EMAIL=contato@seudominio.com
SMTP_FROM_NAME=Design Hub
PASSWORD_RESET_TTL_MINUTES=30
