APP_NAME=design-hub-v2
NODE_ENV=development

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DEMO_MODE=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=design_hub_v2
DB_USER=root
DB_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
APP_TIMEZONE=America/Sao_Paulo
# Em produção, use uma pasta absoluta fora de hbuilds/versions.
# Exemplo Hostinger: /home/SEU_USUARIO/design-hub-v2-uploads
UPLOAD_DIR=uploads
OPENAI_API_KEY=

# Recuperação de senha por uma caixa de e-mail criada na Hostinger.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=senha-da-caixa-de-email
SMTP_FROM_EMAIL=contato@seudominio.com
SMTP_FROM_NAME=Design Hub
PASSWORD_RESET_TTL_MINUTES=30

# Integração privada com a Meta. Gere a chave com:
# openssl rand -base64 32
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/meta/callback
META_TOKEN_ENCRYPTION_KEY=

# Brand Brain AI: server only. Enable explicitly after applying the telemetry migration.
BRAND_BRAIN_AI_ENABLED=false
BRAND_BRAIN_AI_MODEL=gpt-4.1-mini
BRAND_BRAIN_AI_MAX_OUTPUT_TOKENS=6000
BRAND_BRAIN_AI_TIMEOUT_MS=30000
